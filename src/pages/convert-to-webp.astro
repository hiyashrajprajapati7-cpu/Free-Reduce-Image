---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ImageReducerApp from '../components/ImageReducerApp.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FormatComparison from '../components/FormatComparison.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Convert Images to WebP Online (Free & Batch) — Free Reduce Image"
  description="Convert JPG, PNG, GIF and AVIF images to modern WebP format online. Reduce file size up to 85% with transparent alpha channel support. 100% private in-browser tool."
  canonical="https://freereduceimage.com/convert-to-webp"
>
  <Navbar />
  
  <main class="flex-1">
    <ImageReducerApp 
      eyebrow="FORMAT CONVERTER & OPTIMIZER"
      title="Convert to WebP: shrink weight, keep alpha."
      subtitle="Convert heavy PNG and JPG photos into lightweight WebP files. Cut webpage payload by up to 85% while retaining transparent backgrounds and vibrant colors."
      initialMode="convert" 
      defaultFormat="webp" 
    />

    <FormatComparison />
    <FeatureGrid />
    <FAQSection />
  </main>

  <Footer />
</Layout>

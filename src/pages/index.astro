---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ImageReducerApp from '../components/ImageReducerApp.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FormatComparison from '../components/FormatComparison.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Free Reduce Image — Free AI Image Reducer & Compressor"
  description="Upload an image and reduce file size in seconds — with exact target KB caps, DPI control, and zero quality loss. 100% private in-browser tool."
  canonical="https://freereduceimage.com/"
>
  <Navbar />
  
  <main class="flex-1">
    <ImageReducerApp initialMode="auto" />
    <FeatureGrid />
    <FormatComparison />
    <UseCasesSection />
    <FAQSection />
  </main>

  <Footer />
</Layout>

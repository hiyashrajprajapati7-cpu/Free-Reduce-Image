---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  schema?: Record<string, any>;
}

const {
  title = "Free Reduce Image — Free AI Image Reducer & Compressor",
  description = "Free image reducer by image. Upload, paste or drop photos and reduce file size in seconds — with exact target KB caps, DPI control, and zero quality loss.",
  canonical = "https://freereduceimage.com/",
  keywords = "free reduce image, image compressor, font finder ai, reduce image size, batch image resizer, convert to webp, reduce image to 100kb, compress photos, privacy image optimizer",
  schema
} = Astro.props;

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Reduce Image",
  "url": "https://freereduceimage.com",
  "description": "Upload an image and reduce file size — with exact target KB caps, DPI control, and zero quality loss. 100% private in-browser tool.",
  "applicationCategory": "DesignApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "isAccessibleForFree": true,
  "featureList": [
    "Image reducer by image — upload, drag or paste a screenshot",
    "100% Private Client-Side In-Browser Processing",
    "Target File Size Reduction (<50KB, <100KB, <200KB, <1MB)",
    "Batch Multi-File Compression (100+ files) with 1-Click ZIP",
    "Dimension & DPI Resizing (72, 150, 300, 600 DPI)",
    "WebP, AVIF, JPEG, PNG, GIF Converter",
    "Interactive Split Comparison Slider",
    "EXIF & GPS Metadata Stripper"
  ]
};

const jsonLd = schema || defaultSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Free Reduce Image" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Instant Zero-FOUC Dark Mode Initializer -->
    <script is:inline>
      (function() {
        try {
          const storedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[var(--color-canvas)] text-[var(--color-body)] antialiased selection:bg-[var(--color-ink)] selection:text-[var(--color-canvas)] flex flex-col min-h-screen">
    <slot />
  </body>
</html>

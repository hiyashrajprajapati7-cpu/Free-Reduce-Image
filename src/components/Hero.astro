---
interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
}

const {
  badge = "100% Client-Side • Zero Server Uploads • Unlimited Files",
  title = "Reduce Image File Size in Seconds.",
  subtitle = "Upload one image or hundreds at once and reduce their file size quickly and easily. Free Reduce Image intelligently optimizes your images to make them smaller while preserving original visual quality. Smaller files. Faster uploads. Less storage. Better performance."
} = Astro.props;
---

<section class="relative overflow-hidden pt-12 pb-8 md:pt-16 md:pb-12 border-b border-[#ebebeb] bg-[#fafafa]">
  <!-- Mesh Gradient Bloom Background -->
  <div class="absolute inset-0 pointer-events-none opacity-60 hero-mesh-gradient"></div>
  
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/80 border border-[#ebebeb] shadow-[0_1px_2px_rgba(0,0,0,0.04)] mb-6 backdrop-blur-sm">
      <span class="w-2 h-2 rounded-full bg-[#0070f3]"></span>
      <span class="text-xs font-mono font-medium text-[#171717] tracking-tight uppercase">{badge}</span>
    </div>

    <!-- Main Headline with tight display tracking -->
    <h1 class="text-display-xl text-[#171717] max-w-3xl mx-auto mb-6 tracking-[-0.05em] font-semibold text-balance">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg text-[#4d4d4d] max-w-2xl mx-auto leading-relaxed mb-8 text-balance">
      {subtitle}
    </p>

    <!-- Quick Pill Badges -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-medium text-[#4d4d4d]">
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        <span>No File Limits</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        <span>WebP, AVIF, JPG, PNG</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        <span>Target Size (KB)</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        <span>Batch 1-Click ZIP</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        <span>100% Private (No Uploads)</span>
      </div>
    </div>
  </div>
</section>

---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  eyebrow = "FREE AI IMAGE REDUCER",
  title = "Image reducer: what size do you need?",
  subtitle = "Upload an image and shrink it in seconds — with exact target KB caps, DPI control, and zero quality loss."
} = Astro.props;
---

<section class="relative pt-14 pb-8 sm:pt-20 sm:pb-10 bg-[var(--color-canvas)] transition-colors">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <!-- Monospace Eyebrow Badge -->
    <p class="eyebrow">{eyebrow}</p>

    <!-- Main Hero Headline -->
    <h1 class="mt-4 text-display-xl text-[var(--color-ink)] text-balance">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="mx-auto mt-5 max-w-xl text-body-lg text-[var(--color-body)] text-balance">
      {subtitle}
    </p>
  </div>
</section>

---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-canvas)] border-t border-[var(--color-hairline)] py-12 md:py-16 text-xs text-[var(--color-mute)] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand column -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-3 group">
          <div class="w-7 h-7 rounded-lg bg-[var(--color-ink)] text-[var(--color-canvas)] flex items-center justify-center shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
              <path d="M12 12v9"></path>
              <path d="m8 17 4 4 4-4"></path>
            </svg>
          </div>
          <span class="font-semibold text-sm text-[var(--color-ink)] tracking-tight">Free Reduce Image</span>
        </a>
        <p class="text-[11px] text-[var(--color-mute)] leading-relaxed mb-3">
          The fastest, 100% private batch image size reducer and optimizer. Zero server uploads.
        </p>
        <div class="inline-flex items-center gap-1.5 text-[10px] font-mono text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Privacy First • In-Browser
        </div>
      </div>

      <!-- Tools column -->
      <div>
        <h4 class="font-mono text-xs text-[var(--color-ink)] uppercase tracking-wider mb-3">Tools & Modes</h4>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-[var(--color-ink)] transition-colors">Smart Auto Reducer</a></li>
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Reduce to Target Size (KB)</a></li>
          <li><a href="/convert-to-webp" class="hover:text-[var(--color-ink)] transition-colors">Convert Images to WebP</a></li>
          <li><a href="/passport-photo" class="hover:text-[var(--color-ink)] transition-colors">Passport Photo & 300 DPI Resizer</a></li>
        </ul>
      </div>

      <!-- Popular Sizes column -->
      <div>
        <h4 class="font-mono text-xs text-[var(--color-ink)] uppercase tracking-wider mb-3">Target Sizes</h4>
        <ul class="space-y-2 font-mono text-[11px]">
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Compress to under 50 KB</a></li>
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Compress to under 100 KB</a></li>
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Compress to under 200 KB</a></li>
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Compress to under 1 MB</a></li>
        </ul>
      </div>

      <!-- Formats column -->
      <div>
        <h4 class="font-mono text-xs text-[var(--color-ink)] uppercase tracking-wider mb-3">Formats Supported</h4>
        <ul class="space-y-2">
          <li><span class="hover:text-[var(--color-ink)]">WebP Compressor</span></li>
          <li><span class="hover:text-[var(--color-ink)]">AVIF Optimizer</span></li>
          <li><span class="hover:text-[var(--color-ink)]">PNG to WebP / JPG</span></li>
          <li><span class="hover:text-[var(--color-ink)]">JPEG / JPG Reducer</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright row -->
    <div class="pt-8 border-t border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
      <p>&copy; {year} Free Reduce Image (freereduceimage.com). All rights reserved.</p>
      <div class="flex items-center gap-4">
        <span>No cookies or personal tracking</span>
        <span>•</span>
        <span>100% Client-Side Processing</span>
      </div>
    </div>

  </div>
</footer>

---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-canvas)] py-12 sm:py-16 text-xs text-[var(--color-mute)] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand column -->
      <div class="sm:col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-3 group">
          <div class="w-7 h-7 rounded-lg bg-[var(--color-ink)] text-[var(--color-canvas)] flex items-center justify-center shadow-xs group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
              <path d="M12 12v9"></path>
              <path d="m8 17 4 4 4-4"></path>
            </svg>
          </div>
          <span class="text-[var(--color-ink)] font-bold tracking-tight text-base sm:text-lg">
            Free Reduce Image
          </span>
        </a>
        <p class="text-body-sm text-[var(--color-mute)] leading-relaxed mb-4">
          A free in-browser image reducer that compresses photos, enforces target KB caps, and converts formats locally.
        </p>
        <div class="inline-flex items-center gap-1.5 text-[11px] font-mono text-[var(--color-ink)] bg-[var(--color-canvas-subtle)] px-2.5 py-1 rounded-full border border-[var(--color-hairline)]">
          <span class="size-1.5 rounded-full bg-[var(--color-ink)]"></span>
          100% Private In-Browser
        </div>
      </div>

      <!-- Tools & Modes -->
      <div>
        <h4 class="font-mono text-xs text-[var(--color-ink)] uppercase tracking-wider mb-3">Tools & Modes</h4>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-[var(--color-ink)] transition-colors">Smart Auto Reducer</a></li>
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Reduce to Target Size (KB)</a></li>
          <li><a href="/convert-to-webp" class="hover:text-[var(--color-ink)] transition-colors">Convert Images to WebP</a></li>
          <li><a href="/passport-photo" class="hover:text-[var(--color-ink)] transition-colors">Passport Photo & 300 DPI</a></li>
        </ul>
      </div>

      <!-- Target Sizes -->
      <div>
        <h4 class="font-mono text-xs text-[var(--color-ink)] uppercase tracking-wider mb-3">Target Sizes</h4>
        <ul class="space-y-2 font-mono text-[11px]">
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Compress under 50 KB</a></li>
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Compress under 100 KB</a></li>
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Compress under 200 KB</a></li>
          <li><a href="/target-file-size" class="hover:text-[var(--color-ink)] transition-colors">Compress under 1 MB</a></li>
        </ul>
      </div>

      <!-- Formats Supported -->
      <div>
        <h4 class="font-mono text-xs text-[var(--color-ink)] uppercase tracking-wider mb-3">Formats</h4>
        <ul class="space-y-2">
          <li><a href="/convert-to-webp" class="hover:text-[var(--color-ink)] transition-colors">WebP (High Efficiency)</a></li>
          <li><a href="/convert-to-webp" class="hover:text-[var(--color-ink)] transition-colors">AVIF (Next-Gen)</a></li>
          <li><a href="/" class="hover:text-[var(--color-ink)] transition-colors">JPEG / JPG Optimizer</a></li>
          <li><a href="/" class="hover:text-[var(--color-ink)] transition-colors">PNG Compressor</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright row -->
    <div class="pt-8 border-t border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
      <p>&copy; {year} Free Reduce Image. Unlimited scans, no account required.</p>
      <div class="flex items-center gap-4 text-[var(--color-mute)]">
        <span>No server uploads</span>
        <span>•</span>
        <span>No tracking cookies</span>
        <span>•</span>
        <span>Client-Side Processing</span>
      </div>
    </div>

  </div>
</footer>

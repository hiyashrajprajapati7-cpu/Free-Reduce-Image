<!-- How it works Section (Exact fontfinderai.com style) -->
<section
  id="how-it-works"
  class="py-16 sm:py-20 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] transition-colors"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-display-lg text-[var(--color-ink)]">How it works</h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <!-- Step 01 -->
      <div class="card-solid p-6 sm:p-7">
        <p class="font-mono text-xs text-[var(--color-mute)] font-semibold">
          01
        </p>
        <h3 class="mt-3 text-display-sm text-[var(--color-ink)]">
          Upload or paste
        </h3>
        <p class="mt-2 text-body-md text-[var(--color-body)]">
          Drop photos, logos, or screenshots directly onto the page, or paste
          straight from your clipboard. Upload single or 100+ files at once.
        </p>
      </div>

      <!-- Step 02 -->
      <div class="card-solid p-6 sm:p-7">
        <p class="font-mono text-xs text-[var(--color-mute)] font-semibold">
          02
        </p>
        <h3 class="mt-3 text-display-sm text-[var(--color-ink)]">
          Set size or parameters
        </h3>
        <p class="mt-2 text-body-md text-[var(--color-body)]">
          Choose smart auto compression, enter an exact maximum file size (e.g.
          &lt;100 KB for government visa forms), or customize DPI and pixel
          dimensions.
        </p>
      </div>

      <!-- Step 03 -->
      <div class="card-solid p-6 sm:p-7">
        <p class="font-mono text-xs text-[var(--color-mute)] font-semibold">
          03
        </p>
        <h3 class="mt-3 text-display-sm text-[var(--color-ink)]">
          Instant download & ZIP
        </h3>
        <p class="mt-2 text-body-md text-[var(--color-body)]">
          Your browser compresses files locally at native hardware speed.
          Compare before and after side-by-side, then save individual files or
          download all in a single ZIP.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Built to be trusted Section (Exact fontfinderai.com style) -->
<section
  class="py-16 sm:py-20 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] transition-colors"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-display-lg text-[var(--color-ink)]">
      Built to be trusted, not just fast
    </h2>
    <p class="mt-3 max-w-2xl text-body-lg text-[var(--color-body)]">
      Most image compressors upload your sensitive personal photos to unknown
      remote servers. Free Reduce Image runs entirely in your own web browser.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <!-- Trust Card 1 -->
      <div class="card-solid p-6 sm:p-7">
        <h3 class="text-display-sm text-[var(--color-ink)]">
          100% In-browser privacy
        </h3>
        <p class="mt-2 text-body-md text-[var(--color-body)]">
          All image compression, scaling, and format conversion runs locally
          inside your browser using HTML5 Canvas & Web Workers. Your photos are
          never uploaded or stored.
        </p>
      </div>

      <!-- Trust Card 2 -->
      <div class="card-solid p-6 sm:p-7">
        <h3 class="text-display-sm text-[var(--color-ink)]">
          Exact target byte limits
        </h3>
        <p class="mt-2 text-body-md text-[var(--color-body)]">
          Government portals and immigration forms strictly enforce caps like
          &lt;100 KB or &lt;50 KB. Our binary search engine calculates the exact
          compression required on the first pass.
        </p>
      </div>

      <!-- Trust Card 3 -->
      <div class="card-solid p-6 sm:p-7">
        <h3 class="text-display-sm text-[var(--color-ink)]">
          Zero quality compromise
        </h3>
        <p class="mt-2 text-body-md text-[var(--color-body)]">
          Perceptual chroma subsampling and adaptive quantization remove
          invisible noise without sacrificing razor-sharp edge contrast or
          vibrant colors.
        </p>
      </div>

      <!-- Trust Card 4 -->
      <div class="card-solid p-6 sm:p-7">
        <h3 class="text-display-sm text-[var(--color-ink)]">
          Automatic EXIF & GPS cleaner
        </h3>
        <p class="mt-2 text-body-md text-[var(--color-body)]">
          Every processed image has its camera serial numbers, lens profiles,
          exposure details, and sensitive GPS geolocation coordinates
          permanently stripped.
        </p>
      </div>
    </div>
  </div>
</section>

---
const useCases = [
  {
    category: "Web & Core Web Vitals",
    title: "Accelerate Page Speed & SEO Rankings",
    description: "Heavy hero banners and unoptimized PNGs destroy your Google Lighthouse score. Converting and compressing to WebP cuts load times drastically.",
    tags: ["Core Web Vitals", "Lighthouse 100", "LCP Boost"]
  },
  {
    category: "Visa & Government Portals",
    title: "Pass Strict File Size Upload Limits",
    description: "Government immigration portals, passport renewal forms, and job applications reject files larger than 100 KB or 50 KB. Use our Target Size tool to hit exact limits on the first try.",
    tags: ["< 100 KB Limit", "2x2 inch Passport", "300 DPI"]
  },
  {
    category: "E-Commerce & Storefronts",
    title: "Bulk Optimize Product Catalogs",
    description: "High-resolution product galleries bog down mobile shoppers. Batch-reduce hundreds of product photos simultaneously and download all optimized files in a single ZIP.",
    tags: ["Shopify Ready", "WooCommerce", "Batch ZIP"]
  },
  {
    category: "Social Media & Chat",
    title: "Discord, Slack & Email Attachments",
    description: "Avoid email attachment bounce-backs (25MB caps) and Discord upload limits by effortlessly shrinking oversized 10MB camera shots to light 500KB files.",
    tags: ["Email Safe", "Discord Avatar", "No Compression Artifacts"]
  }
];
---

<section class="py-16 md:py-24 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="max-w-2xl mx-auto text-center mb-12">
      <span class="text-mono-eyebrow text-[var(--color-mute)] block mb-2">Designed For Real Workflows</span>
      <h2 class="text-heading-lg text-[var(--color-ink)] mb-4">
        Built for developers, job seekers, and digital creators.
      </h2>
      <p class="text-sm sm:text-base text-[var(--color-body)]">
        Whether shrinking a passport photo or optimizing 500 product listings, Free Reduce Image gets the job done instantly.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {useCases.map((uc) => (
        <div class="hairline-card p-6 sm:p-8 bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] flex flex-col justify-between hover:border-[var(--color-ink)]/50 transition-all">
          <div>
            <span class="text-mono-eyebrow text-[var(--color-link)] block mb-2">{uc.category}</span>
            <h3 class="text-lg font-semibold text-[var(--color-ink)] mb-2 tracking-tight">{uc.title}</h3>
            <p class="text-sm text-[var(--color-body)] leading-relaxed mb-6">{uc.description}</p>
          </div>

          <div class="flex flex-wrap gap-2 pt-4 border-t border-[var(--color-hairline)]">
            {uc.tags.map((tag) => (
              <span class="px-2.5 py-1 rounded-md bg-[var(--color-canvas-subtle)] border border-[var(--color-hairline)] text-[11px] font-mono text-[var(--color-body)]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

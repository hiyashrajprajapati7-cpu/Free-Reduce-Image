---
---

<header class="sticky top-0 z-50 bg-[var(--color-canvas)]/90 backdrop-blur-md border-b border-[var(--color-hairline)] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0 text-[var(--color-ink)] font-semibold tracking-tight text-base">
      <div class="w-7 h-7 rounded-md bg-[var(--color-ink)] text-[var(--color-canvas)] flex items-center justify-center text-xs font-mono font-bold shadow-xs">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
          <path d="M12 12v9"></path>
          <path d="m8 17 4 4 4-4"></path>
        </svg>
      </div>
      <span>Free Reduce Image</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      <a href="/" class="rounded-full px-3 py-1.5 text-xs lg:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
        Smart Reducer
      </a>
      <a href="/target-file-size" class="rounded-full px-3 py-1.5 text-xs lg:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
        Target Size (KB)
      </a>
      <a href="/convert-to-webp" class="rounded-full px-3 py-1.5 text-xs lg:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
        Convert Formats
      </a>
      <a href="/passport-photo" class="rounded-full px-3 py-1.5 text-xs lg:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
        Passport & DPI
      </a>
      <a href="/#how-it-works" class="rounded-full px-3 py-1.5 text-xs lg:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
        How it works
      </a>
      <a href="/#faq" class="rounded-full px-3 py-1.5 text-xs lg:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
        FAQ
      </a>
    </nav>

    <!-- Right Controls: Theme switch + Primary CTA -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Dark / Light Mode Switcher -->
      <button 
        type="button" 
        id="theme-toggle" 
        class="w-8 h-8 rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-subtle)] flex items-center justify-center transition-colors cursor-pointer"
        aria-label="Switch color theme"
        title="Toggle Theme"
      >
        <!-- Sun Icon (visible in Dark mode) -->
        <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon Icon (visible in Light mode) -->
        <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <!-- Primary Action Button (White pill on dark) -->
      <a href="#identify" class="rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] px-3.5 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium transition-opacity hover:opacity-90">
        Reduce an image
      </a>
    </div>
  </div>

  <!-- Mobile Nav Scrollbar -->
  <div class="flex md:hidden px-4 pb-2.5 overflow-x-auto gap-1 border-t border-[var(--color-hairline)] pt-2">
    <a href="/" class="shrink-0 rounded-full px-3 py-1 text-xs text-[var(--color-body)] hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">Smart Reducer</a>
    <a href="/target-file-size" class="shrink-0 rounded-full px-3 py-1 text-xs text-[var(--color-body)] hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">Target Size</a>
    <a href="/convert-to-webp" class="shrink-0 rounded-full px-3 py-1 text-xs text-[var(--color-body)] hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">Convert WebP</a>
    <a href="/passport-photo" class="shrink-0 rounded-full px-3 py-1 text-xs text-[var(--color-body)] hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">Passport & DPI</a>
    <a href="/#faq" class="shrink-0 rounded-full px-3 py-1 text-xs text-[var(--color-body)] hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">FAQ</a>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
  });
</script>

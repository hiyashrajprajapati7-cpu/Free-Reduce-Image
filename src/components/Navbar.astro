---
---

<header class="sticky top-0 z-50 bg-[var(--color-canvas)]/90 backdrop-blur-md border-b border-[var(--color-hairline)] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo & Title -->
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-7 h-7 rounded-lg bg-[var(--color-ink)] text-[var(--color-canvas)] flex items-center justify-center shadow-xs group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
          <path d="M12 12v9"></path>
          <path d="m8 17 4 4 4-4"></path>
        </svg>
      </div>
      <span class="text-[var(--color-ink)] font-bold tracking-tight text-lg sm:text-xl">
        Free Reduce Image
      </span>
    </a>

    <!-- Right Side: Nav Links + Theme Switch + CTA Button -->
    <div class="flex items-center gap-2 sm:gap-3 ml-auto">
      <!-- Nav Links -->
      <nav class="hidden md:flex items-center gap-1 mr-1" aria-label="Main navigation">
        <a href="/#how-it-works" class="rounded-full px-3 py-1.5 text-xs sm:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
          How it works
        </a>
        <a href="/#faq" class="rounded-full px-3 py-1.5 text-xs sm:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
          FAQ
        </a>
      </nav>

      <!-- Dark / Light Mode Switcher with Smooth Rotation on Click -->
      <button 
        type="button" 
        id="theme-toggle" 
        class="w-8 h-8 rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-subtle)] flex items-center justify-center transition-all duration-200 active:scale-90 cursor-pointer"
        aria-label="Switch color theme"
        title="Toggle Theme"
      >
        <!-- Sun Icon (visible in Dark mode) -->
        <svg class="w-4 h-4 hidden dark:block transition-transform duration-300 group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon Icon (visible in Light mode) -->
        <svg class="w-4 h-4 block dark:hidden transition-transform duration-300 group-hover:-rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <!-- Primary Action Button (White pill on dark) -->
      <a href="#identify" class="rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] px-3.5 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium transition-all duration-150 hover:opacity-90 active:scale-95 shadow-2xs">
        Reduce an image
      </a>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div class="flex md:hidden px-4 pb-2 justify-center gap-3 border-t border-[var(--color-hairline)] pt-2 text-xs">
    <a href="/#how-it-works" class="rounded-full px-3 py-1 text-[var(--color-body)] hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">How it works</a>
    <a href="/#faq" class="rounded-full px-3 py-1 text-[var(--color-body)] hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">FAQ</a>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
  });
</script>

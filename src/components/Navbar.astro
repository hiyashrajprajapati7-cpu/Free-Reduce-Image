---
---

<header data-site-header class="sticky top-0 z-50 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]/85 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 flex h-14 sm:h-16 items-center gap-3 sm:gap-4">
    <!-- Brand Logo & Title -->
    <a href="/" class="flex items-center gap-2 font-medium tracking-tight text-[var(--color-ink)] flex-shrink-0 group">
      <div class="w-6 h-6 rounded-md bg-[var(--color-ink)] text-[var(--color-canvas)] flex items-center justify-center shadow-2xs group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
          <path d="M12 12v9"></path>
          <path d="m8 17 4 4 4-4"></path>
        </svg>
      </div>
      <span class="text-sm sm:text-base font-bold tracking-tight">Free Reduce Image</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Main navigation">
      <a href="/#faq" class="rounded-full px-3 py-2 text-xs sm:text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">
        FAQ
      </a>
    </nav>

    <!-- Right Controls: Theme switch + Primary CTA -->
    <div class="ml-auto flex items-center gap-1.5 sm:gap-2 md:ml-0">
      <!-- Dark / Light Mode Switcher -->
      <button 
        type="button" 
        id="theme-toggle" 
        class="grid size-9 sm:size-8 cursor-pointer place-items-center rounded-full border border-[var(--color-hairline)] text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)] active:scale-90"
        aria-label="Switch colour theme"
        title="Toggle Theme"
      >
        <!-- Sun Icon (visible in Dark mode) -->
        <svg class="size-4 hidden dark:block transition-transform duration-300 group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <!-- Moon Icon (visible in Light mode) -->
        <svg class="size-4 block dark:hidden transition-transform duration-300 group-hover:-rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <!-- Primary Action Button -->
      <a href="#identify" class="rounded-sm bg-[var(--color-primary)] px-3 py-2 sm:py-1.5 text-xs sm:text-sm font-medium text-[var(--color-on-primary)] transition-opacity hover:opacity-90 active:scale-95 shadow-2xs min-h-[44px] sm:min-h-0 inline-flex items-center">
        Reduce an image
      </a>
    </div>
  </div>

  <!-- Mobile Nav -->
  <nav class="max-w-6xl mx-auto flex justify-end gap-1 px-4 pb-2 md:hidden" aria-label="Mobile Navigation">
    <a href="/#faq" class="rounded-full px-3 py-1.5 text-xs text-[var(--color-body)] hover:bg-[var(--color-canvas-subtle)] hover:text-[var(--color-ink)]">FAQ</a>
  </nav>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
  });
</script>

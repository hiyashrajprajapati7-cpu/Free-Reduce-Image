---
---

<header class="sticky top-0 z-50 bg-[#fafafa]/90 backdrop-blur-md border-b border-[#ebebeb] transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[#171717] text-white flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
          <path d="M12 12v9"></path>
          <path d="m8 17 4 4 4-4"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-semibold text-[15px] tracking-tight text-[#171717] leading-none">Free Reduce Image</span>
        <span class="text-[10px] text-[#8f8f8f] font-mono tracking-wider uppercase mt-0.5">freereduceimage.com</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-1">
      <a href="/" class="px-3 py-1.5 text-sm text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/60 rounded-full transition-colors font-medium">
        Image Reducer
      </a>
      <a href="/target-file-size" class="px-3 py-1.5 text-sm text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/60 rounded-full transition-colors font-medium">
        Target Size (KB)
      </a>
      <a href="/convert-to-webp" class="px-3 py-1.5 text-sm text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/60 rounded-full transition-colors font-medium">
        Convert to WebP
      </a>
      <a href="/passport-photo" class="px-3 py-1.5 text-sm text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/60 rounded-full transition-colors font-medium">
        Passport & DPI
      </a>
    </nav>

    <!-- Right Badges / Actions -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#ebebeb]/60 border border-[#ebebeb] text-[11px] font-mono text-[#4d4d4d]">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        100% Client-Side Private
      </div>
      <a href="#app" class="px-3.5 py-1.5 text-xs font-medium bg-[#171717] text-white rounded-md hover:bg-black transition-all shadow-sm">
        Reduce Images
      </a>
    </div>
  </div>
</header>

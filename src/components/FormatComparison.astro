---
const formats = [
  {
    name: "WebP",
    badge: "Recommended",
    bestFor: "Websites, apps, e-commerce stores",
    savings: "Up to 85%",
    alpha: "Yes (Full)",
    support: "97%+ (All Modern Browsers)",
    quality: "75% - 85%"
  },
  {
    name: "AVIF",
    badge: "Next-Gen",
    bestFor: "Maximum compression for modern platforms",
    savings: "Up to 90%",
    alpha: "Yes (Full)",
    support: "94%+ (Chrome, Firefox, Safari)",
    quality: "65% - 80%"
  },
  {
    name: "JPEG / JPG",
    badge: "Universal",
    bestFor: "Photographs, print, passport applications",
    savings: "Up to 70%",
    alpha: "No",
    support: "100% Universal",
    quality: "80% - 90%"
  },
  {
    name: "PNG",
    badge: "Lossless",
    bestFor: "Logos, screenshots, graphics with sharp text",
    savings: "Up to 50%",
    alpha: "Yes (Lossless)",
    support: "100% Universal",
    quality: "Lossless / 100%"
  },
  {
    name: "GIF",
    badge: "Animated",
    bestFor: "Simple animated graphics and banners",
    savings: "Up to 40%",
    alpha: "1-bit binary",
    support: "100% Universal",
    quality: "256 colors"
  }
];
---

<section class="py-16 sm:py-20 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="max-w-2xl mb-10">
      <p class="eyebrow">Technical Specification</p>
      <h2 class="mt-3 text-display-lg text-[var(--color-ink)]">
        Which image format is right for you?
      </h2>
      <p class="mt-2 text-body-md text-[var(--color-body)]">
        Choosing the right output format guarantees minimum byte payload with maximum visual fidelity.
      </p>
    </div>

    <!-- Solid Table Card -->
    <div class="rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas-subtle)] text-[var(--color-mute)] font-mono text-[11px] uppercase tracking-wider">
              <th class="py-3.5 px-4 sm:px-6 font-medium">Format</th>
              <th class="py-3.5 px-4 sm:px-6 font-medium">Best Suited For</th>
              <th class="py-3.5 px-4 sm:px-6 font-medium">Size Reduction</th>
              <th class="py-3.5 px-4 sm:px-6 font-medium">Transparency</th>
              <th class="py-3.5 px-4 sm:px-6 font-medium">Browser Support</th>
              <th class="py-3.5 px-4 sm:px-6 font-medium">Optimal Quality</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-hairline)]">
            {formats.map((fmt) => (
              <tr class="hover:bg-[var(--color-canvas-subtle)] transition-colors">
                <td class="py-4 px-4 sm:px-6">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[var(--color-ink)] font-mono text-sm">{fmt.name}</span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)]">{fmt.badge}</span>
                  </div>
                </td>
                <td class="py-4 px-4 sm:px-6 text-[var(--color-body)]">{fmt.bestFor}</td>
                <td class="py-4 px-4 sm:px-6 font-mono font-semibold text-emerald-500">{fmt.savings}</td>
                <td class="py-4 px-4 sm:px-6 font-mono text-[var(--color-body)]">{fmt.alpha}</td>
                <td class="py-4 px-4 sm:px-6 text-[var(--color-body)]">{fmt.support}</td>
                <td class="py-4 px-4 sm:px-6 font-mono text-[var(--color-ink)]">{fmt.quality}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  initialMode?: 'auto' | 'target' | 'dimensions' | 'convert';
  defaultFormat?: string;
  defaultTargetKb?: number;
  isPassportMode?: boolean;
}

const {
  eyebrow = "FREE AI IMAGE REDUCER",
  title = "Image reducer: what size do you need?",
  subtitle = "Upload an image and shrink it in seconds — with exact target KB caps, DPI control, and zero quality loss.",
  initialMode = 'auto',
  defaultFormat = 'auto',
  defaultTargetKb = 100,
  isPassportMode = false
} = Astro.props;
---

<section id="identify" class="relative pb-12 pt-12 sm:pt-20 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] transition-colors">
  <!-- Subtle Top Atmospheric Mask matching fontfinderai.com -->
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[380px] overflow-hidden" aria-hidden="true">
    <div class="absolute inset-x-0 top-[-220px] h-[520px] opacity-[0.08] blur-[110px] dark:opacity-[0.14]" style="background: radial-gradient(38% 55% at 32% 45%, var(--color-ink) 0%, transparent 100%), radial-gradient(36% 52% at 68% 40%, var(--color-ink) 0%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%), linear-gradient(to right, transparent 0%, #000 18%, #000 82%, transparent 100%); mask-image: linear-gradient(to bottom, #000 35%, transparent 100%), linear-gradient(to right, transparent 0%, #000 18%, #000 82%, transparent 100%);"></div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 w-full text-center">

    <!-- Hero Header with Exact fontfinderai Typography -->
    <div class="animate-fade-in-up">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-4 text-[2.5rem] font-semibold leading-[1.05] tracking-[-0.045em] text-[var(--color-ink)] sm:text-[3.5rem] text-balance">
        {title}
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-body-lg text-[var(--color-body)] text-balance">
        {subtitle}
      </p>
    </div>

    <!-- Reducer Workspace Container -->
    <div class="mx-auto mt-10 max-w-3xl animate-fade-in-up [animation-delay:120ms]">
      
      <!-- Top Mode Selector Tabs + Quick Presets Bar -->
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3 px-1">
        <!-- Mode Tabs -->
        <div class="inline-flex flex-wrap items-center gap-1 p-1 bg-[var(--color-canvas-subtle)] border border-[var(--color-hairline)] rounded-full text-xs font-medium" id="mode-tabs">
          <button type="button" data-mode="auto" class={`mode-tab px-3.5 py-1.5 rounded-full transition-all duration-200 ${initialMode === 'auto' && !isPassportMode ? 'active-mode' : ''}`}>
            Smart Auto
          </button>
          <button type="button" data-mode="target" class={`mode-tab px-3.5 py-1.5 rounded-full transition-all duration-200 ${initialMode === 'target' ? 'active-mode' : ''}`}>
            Target Size (KB)
          </button>
          <button type="button" data-mode="dimensions" class={`mode-tab px-3.5 py-1.5 rounded-full transition-all duration-200 ${initialMode === 'dimensions' || isPassportMode ? 'active-mode' : ''}`}>
            Dimensions & DPI
          </button>
          <button type="button" data-mode="convert" class={`mode-tab px-3.5 py-1.5 rounded-full transition-all duration-200 ${initialMode === 'convert' ? 'active-mode' : ''}`}>
            Convert Format
          </button>
        </div>

        <!-- Presets -->
        <div class="flex items-center gap-1.5 ml-auto">
          <label class="text-[11px] font-mono text-[var(--color-mute)] uppercase hidden sm:inline">Presets:</label>
          <select id="quick-preset" class="minimal-input text-xs py-1 px-2.5 bg-[var(--color-canvas)] text-[var(--color-ink)] cursor-pointer hover:border-[var(--color-ink)] transition-colors">
            <option value="">Custom Settings</option>
            <option value="web-opt" selected={initialMode === 'auto'}>Web Ready (80% WebP)</option>
            <option value="target-50">Under 50 KB (Avatars & Forms)</option>
            <option value="target-100" selected={initialMode === 'target'}>Under 100 KB (Govt & Visa)</option>
            <option value="target-200">Under 200 KB (Job Portals)</option>
            <option value="target-1mb">Under 1 MB (Email Safe)</option>
            <option value="passport" selected={isPassportMode}>Passport Photo (2x2" @ 300 DPI)</option>
            <option value="instagram">Square Post (1080×1080)</option>
          </select>
        </div>
      </div>

      <!-- Dashed Dropzone Area matching fontfinderai.com -->
      <div id="dropzone" class="relative rounded-xl border border-dashed border-[var(--color-hairline-strong)] bg-[var(--color-canvas-subtle)] p-8 sm:p-12 text-center transition-colors cursor-pointer group hover:bg-[var(--color-canvas-subtle)]/80">
        <input type="file" id="file-input" multiple accept="image/png,image/jpeg,image/webp,image/avif,image/gif,image/bmp,image/svg+xml" class="sr-only" />
        
        <!-- Upload Tray Arrow Icon with gentle hover lift -->
        <svg class="mx-auto size-10 text-[var(--color-mute)] group-hover:text-[var(--color-ink)] group-hover:-translate-y-1 transition-all duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 16V4m0 0L8 8m4-4 4 4" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M3 15v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4" stroke-linecap="round"></path>
        </svg>

        <!-- Headline -->
        <h2 class="mt-4 text-display-sm text-[var(--color-ink)] font-semibold">
          Drop an image to reduce the size
        </h2>

        <!-- Subtitle -->
        <p class="mx-auto mt-2 max-w-md text-body-sm text-[var(--color-body)]">
          PNG, JPG, WebP, AVIF or GIF. Paste with <kbd class="font-mono text-[10px] px-1.5 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)]">⌘V</kbd> / <kbd class="font-mono text-[10px] px-1.5 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)]">Ctrl+V</kbd>, or drag anywhere.
        </p>

        <!-- Action Buttons (Exact fontfinderai pill sizing) -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <label for="file-input" class="cursor-pointer rounded-full bg-[var(--color-primary)] px-5 py-3 text-body-md font-medium text-[var(--color-on-primary)] transition-all duration-150 hover:opacity-90 active:scale-95 shadow-2xs">
            Choose an image
          </label>
          <button type="button" id="try-sample-btn" class="rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-5 py-3 text-body-md font-medium text-[var(--color-ink)] transition-all duration-150 hover:bg-[var(--color-canvas-subtle)] hover:border-[var(--color-hairline-strong)] active:scale-95 cursor-pointer shadow-2xs">
            Try an example
          </button>
        </div>

        <!-- Trust Caption -->
        <p class="mt-4 text-caption text-[var(--color-mute)]">
          Free and unlimited. No account. Your image is never stored.
        </p>
      </div>

      <!-- Docked Parameters Bar (Modular clean card) -->
      <div id="settings-panel" class="mt-3 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-4 text-xs text-left">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 items-end">
          
          <!-- Output Format -->
          <div>
            <label class="block text-[10px] font-mono uppercase text-[var(--color-mute)] mb-1">Output Format</label>
            <select id="format-select" class="w-full minimal-input bg-[var(--color-canvas)] text-xs py-1.5">
              <option value="auto" selected={defaultFormat === 'auto'}>Auto (Keep Original)</option>
              <option value="image/webp" selected={defaultFormat === 'webp'}>WebP (Recommended)</option>
              <option value="image/jpeg" selected={defaultFormat === 'jpeg'}>JPEG / JPG</option>
              <option value="image/png" selected={defaultFormat === 'png'}>PNG (Lossless)</option>
              <option value="image/avif" selected={defaultFormat === 'avif'}>AVIF (Next-Gen)</option>
            </select>
          </div>

          <!-- Quality Slider -->
          <div id="quality-control">
            <div class="flex justify-between items-center mb-1">
              <label class="text-[10px] font-mono uppercase text-[var(--color-mute)]">Quality</label>
              <span id="quality-val" class="text-[11px] font-mono font-semibold text-[var(--color-ink)]">82%</span>
            </div>
            <input type="range" id="quality-slider" min="5" max="100" value="82" class="w-full accent-[var(--color-ink)] cursor-pointer h-4" />
          </div>

          <!-- Target File Size Control -->
          <div id="target-size-control" class={`${initialMode === 'target' ? 'block' : 'hidden'}`}>
            <label class="block text-[10px] font-mono uppercase text-[var(--color-mute)] mb-1">Max Target Size</label>
            <div class="flex items-center gap-1">
              <input type="number" id="target-kb-input" min="5" max="50000" value={defaultTargetKb} class="w-full minimal-input font-mono bg-[var(--color-canvas)] text-xs py-1.5" />
              <select id="target-unit" class="minimal-input text-xs font-mono py-1.5 px-1.5 bg-[var(--color-canvas)]">
                <option value="KB">KB</option>
                <option value="MB">MB</option>
              </select>
            </div>
          </div>

          <!-- Dimension Controls -->
          <div id="dimension-scale-control" class={`${initialMode === 'dimensions' || isPassportMode ? 'block' : 'hidden'} sm:col-span-2 md:col-span-2`}>
            <div class="grid grid-cols-3 gap-2">
              <div>
                <label class="block text-[10px] font-mono uppercase text-[var(--color-mute)] mb-1">Scale (%)</label>
                <input type="number" id="scale-percent-input" min="10" max="200" value="100" class="w-full minimal-input font-mono bg-[var(--color-canvas)] text-xs py-1.5" />
              </div>
              <div>
                <label class="block text-[10px] font-mono uppercase text-[var(--color-mute)] mb-1">DPI</label>
                <select id="dpi-select" class="w-full minimal-input font-mono text-xs bg-[var(--color-canvas)] py-1.5">
                  <option value="72">72 (Web)</option>
                  <option value="150">150 (Screen)</option>
                  <option value="300" selected={isPassportMode}>300 (Print)</option>
                  <option value="600">600 (Hi-Res)</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] font-mono uppercase text-[var(--color-mute)] mb-1">Fit</label>
                <select id="fit-mode-select" class="w-full minimal-input text-xs bg-[var(--color-canvas)] py-1.5">
                  <option value="contain">Contain</option>
                  <option value="cover">Crop</option>
                  <option value="stretch">Stretch</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Metadata Stripper Toggle -->
          <div class="flex items-center h-8">
            <label class="flex items-center gap-1.5 text-xs font-medium text-[var(--color-body)] cursor-pointer select-none">
              <input type="checkbox" id="strip-exif" checked class="size-3.5 accent-[var(--color-ink)]" />
              <span>Strip EXIF / GPS</span>
            </label>
          </div>

        </div>
      </div>

    </div>

    <!-- Batch Processing Queue Section -->
    <div id="batch-section" class="mt-6 hidden text-left">
      
      <!-- Queue Stats Summary Header -->
      <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] mb-4">
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs">
          <div>
            <span class="text-[var(--color-mute)] block font-mono text-[10px] uppercase">Images</span>
            <span id="stat-count" class="font-semibold text-[var(--color-ink)]">0 files</span>
          </div>
          <div class="w-px h-6 bg-[var(--color-hairline)]"></div>
          <div>
            <span class="text-[var(--color-mute)] block font-mono text-[10px] uppercase">Original</span>
            <span id="stat-original-size" class="font-semibold text-[var(--color-ink)]">0 MB</span>
          </div>
          <div class="w-px h-6 bg-[var(--color-hairline)]"></div>
          <div>
            <span class="text-[var(--color-mute)] block font-mono text-[10px] uppercase">Reduced</span>
            <span id="stat-reduced-size" class="font-semibold text-[var(--color-ink)]">0 MB</span>
          </div>
          <div class="w-px h-6 bg-[var(--color-hairline)]"></div>
          <div>
            <span class="text-[var(--color-mute)] block font-mono text-[10px] uppercase">Saved</span>
            <span id="stat-saved-percent" class="font-semibold text-[var(--color-ink)] bg-[var(--color-canvas-subtle)] px-2.5 py-0.5 rounded-full border border-[var(--color-hairline)]">0%</span>
          </div>
        </div>

        <!-- Batch Action Buttons -->
        <div class="flex items-center gap-2">
          <button type="button" id="clear-all-btn" class="px-3 py-1.5 text-xs text-[var(--color-mute)] hover:text-red-500 rounded-md transition-colors cursor-pointer">
            Clear
          </button>
          <button type="button" id="reprocess-all-btn" class="rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-3 py-1.5 text-xs font-medium text-[var(--color-ink)] hover:bg-[var(--color-canvas-subtle)] transition-colors cursor-pointer">
            Apply
          </button>
          <button type="button" id="download-zip-btn" class="rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] px-4 py-1.5 text-xs font-medium transition-opacity hover:opacity-90 cursor-pointer flex items-center gap-1.5">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download All (ZIP)</span>
          </button>
        </div>
      </div>

      <!-- File cards list -->
      <div id="file-list" class="space-y-3">
        <!-- Dynamically generated items -->
      </div>

    </div>

  </div>
</section>

<!-- Interactive Split Comparison Modal -->
<div id="compare-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-4">
  <div class="bg-[var(--color-canvas-elevated)] rounded-2xl border border-[var(--color-hairline)] shadow-2xl max-w-4xl w-full overflow-hidden flex flex-col max-h-[90vh]">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[var(--color-hairline)] flex items-center justify-between bg-[var(--color-canvas)]">
      <div class="flex items-center gap-3">
        <h3 class="font-semibold text-[var(--color-ink)] text-sm sm:text-base">Before vs After Comparison</h3>
        <span id="modal-savings-badge" class="px-2.5 py-0.5 rounded-full bg-[var(--color-canvas-subtle)] text-[var(--color-ink)] border border-[var(--color-hairline)] text-xs font-mono font-medium"></span>
      </div>
      <button type="button" id="close-modal-btn" class="w-8 h-8 rounded-full hover:bg-[var(--color-canvas-subtle)] flex items-center justify-center text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors cursor-pointer">
        ✕
      </button>
    </div>

    <!-- Comparison Viewport Area -->
    <div class="p-6 flex-1 overflow-auto flex flex-col items-center justify-center bg-[var(--color-canvas-subtle)]">
      <div class="relative max-w-full max-h-[60vh] select-none rounded-lg overflow-hidden border border-[var(--color-hairline)]" id="split-container">
        <!-- Original (Underneath) -->
        <img id="compare-original-img" src="" alt="Original" class="block max-h-[60vh] max-w-full object-contain pointer-events-none" />
        
        <!-- Compressed (Overlaid with clip-path) -->
        <div id="compare-compressed-wrapper" class="absolute inset-0 overflow-hidden pointer-events-none" style="clip-path: inset(0 0 0 50%);">
          <img id="compare-compressed-img" src="" alt="Reduced" class="block max-h-[60vh] max-w-full object-contain pointer-events-none" />
        </div>

        <!-- Draggable Divider Line -->
        <div id="split-divider" class="absolute top-0 bottom-0 w-0.5 bg-white cursor-ew-resize shadow-[0_0_8px_rgba(0,0,0,0.8)] z-10 flex items-center justify-center" style="left: 50%;">
          <div class="w-7 h-7 rounded-full bg-black text-white border border-zinc-700 shadow-md flex items-center justify-center text-[10px]">
            ⇄
          </div>
        </div>

        <!-- Labels -->
        <span class="absolute top-3 left-3 bg-black/80 text-white text-[11px] font-mono px-2 py-0.5 rounded pointer-events-none z-20">Original</span>
        <span class="absolute top-3 right-3 bg-white text-black text-[11px] font-mono px-2 py-0.5 rounded pointer-events-none z-20 font-medium">Reduced</span>
      </div>

      <!-- Info Row -->
      <div class="flex items-center justify-between w-full max-w-md mt-4 text-xs font-mono text-[var(--color-body)]">
        <div id="modal-original-info">Original: -</div>
        <div id="modal-reduced-info">Reduced: -</div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 border-t border-[var(--color-hairline)] flex items-center justify-end gap-3 bg-[var(--color-canvas)]">
      <button type="button" id="modal-close-action" class="rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-4 py-2 text-xs font-medium text-[var(--color-ink)] hover:bg-[var(--color-canvas-subtle)] cursor-pointer">Close</button>
      <a id="modal-download-action" href="#" download="" class="rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] px-5 py-2 text-xs font-medium hover:opacity-90 cursor-pointer">Download Reduced Image</a>
    </div>
  </div>
</div>

<!-- JSZip CDN for in-browser client-side bulk archiving -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script is:inline>
(() => {
  // State management
  let filesQueue = [];
  let currentMode = 'auto'; // auto | target | dimensions | convert
  let currentFormat = 'auto';
  let quality = 0.82;
  let targetKb = 100;
  let targetUnit = 'KB';
  let scalePercent = 100;
  let dpi = 72;
  let fitMode = 'contain';
  let stripExif = true;

  // DOM Elements
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file-input');
  const trySampleBtn = document.getElementById('try-sample-btn');
  const batchSection = document.getElementById('batch-section');
  const fileList = document.getElementById('file-list');
  const modeTabs = document.querySelectorAll('.mode-tab');
  const quickPreset = document.getElementById('quick-preset');
  
  const formatSelect = document.getElementById('format-select');
  const qualitySlider = document.getElementById('quality-slider');
  const qualityVal = document.getElementById('quality-val');
  const targetKbInput = document.getElementById('target-kb-input');
  const targetUnitSelect = document.getElementById('target-unit');
  const scalePercentInput = document.getElementById('scale-percent-input');
  const dpiSelect = document.getElementById('dpi-select');
  const fitModeSelect = document.getElementById('fit-mode-select');
  const stripExifCheckbox = document.getElementById('strip-exif');

  const qualityControl = document.getElementById('quality-control');
  const targetSizeControl = document.getElementById('target-size-control');
  const dimensionScaleControl = document.getElementById('dimension-scale-control');

  const clearAllBtn = document.getElementById('clear-all-btn');
  const reprocessAllBtn = document.getElementById('reprocess-all-btn');
  const downloadZipBtn = document.getElementById('download-zip-btn');

  // Stats Elements
  const statCount = document.getElementById('stat-count');
  const statOriginalSize = document.getElementById('stat-original-size');
  const statReducedSize = document.getElementById('stat-reduced-size');
  const statSavedPercent = document.getElementById('stat-saved-percent');

  // Modal Elements
  const compareModal = document.getElementById('compare-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modalCloseAction = document.getElementById('modal-close-action');
  const modalDownloadAction = document.getElementById('modal-download-action');
  const compareOriginalImg = document.getElementById('compare-original-img');
  const compareCompressedImg = document.getElementById('compare-compressed-img');
  const compareCompressedWrapper = document.getElementById('compare-compressed-wrapper');
  const splitDivider = document.getElementById('split-divider');
  const splitContainer = document.getElementById('split-container');
  const modalSavingsBadge = document.getElementById('modal-savings-badge');
  const modalOriginalInfo = document.getElementById('modal-original-info');
  const modalReducedInfo = document.getElementById('modal-reduced-info');

  // Helpers
  function formatBytes(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function getTargetBytes() {
    const val = parseFloat(targetKbInput.value) || 100;
    return targetUnitSelect.value === 'MB' ? val * 1024 * 1024 : val * 1024;
  }

  // Update mode UI display
  function setMode(mode) {
    currentMode = mode;
    modeTabs.forEach(tab => {
      if (tab.getAttribute('data-mode') === mode) {
        tab.classList.add('active-mode');
      } else {
        tab.classList.remove('active-mode');
      }
    });

    if (mode === 'target') {
      targetSizeControl.classList.remove('hidden');
      dimensionScaleControl.classList.add('hidden');
      qualityControl.classList.remove('hidden');
    } else if (mode === 'dimensions') {
      targetSizeControl.classList.add('hidden');
      dimensionScaleControl.classList.remove('hidden');
      qualityControl.classList.remove('hidden');
    } else if (mode === 'convert') {
      targetSizeControl.classList.add('hidden');
      dimensionScaleControl.classList.add('hidden');
      qualityControl.classList.remove('hidden');
    } else {
      // auto
      targetSizeControl.classList.add('hidden');
      dimensionScaleControl.classList.add('hidden');
      qualityControl.classList.remove('hidden');
    }
  }

  modeTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      setMode(tab.getAttribute('data-mode'));
      if (filesQueue.length > 0) reprocessAll();
    });
  });

  // Preset Handler
  quickPreset?.addEventListener('change', (e) => {
    const val = e.target.value;
    if (val === 'web-opt') {
      setMode('auto');
      formatSelect.value = 'image/webp';
      qualitySlider.value = '80';
      qualityVal.textContent = '80%';
      quality = 0.8;
    } else if (val === 'target-50') {
      setMode('target');
      targetKbInput.value = '50';
      targetUnitSelect.value = 'KB';
    } else if (val === 'target-100') {
      setMode('target');
      targetKbInput.value = '100';
      targetUnitSelect.value = 'KB';
    } else if (val === 'target-200') {
      setMode('target');
      targetKbInput.value = '200';
      targetUnitSelect.value = 'KB';
    } else if (val === 'target-1mb') {
      setMode('target');
      targetKbInput.value = '1';
      targetUnitSelect.value = 'MB';
    } else if (val === 'passport') {
      setMode('dimensions');
      scalePercentInput.value = '100';
      dpiSelect.value = '300';
      fitModeSelect.value = 'contain';
      formatSelect.value = 'image/jpeg';
    } else if (val === 'instagram') {
      setMode('dimensions');
      scalePercentInput.value = '100';
      fitModeSelect.value = 'cover';
      formatSelect.value = 'image/jpeg';
      qualitySlider.value = '85';
      qualityVal.textContent = '85%';
    }
    if (filesQueue.length > 0) reprocessAll();
  });

  // Input Listeners
  qualitySlider?.addEventListener('input', (e) => {
    quality = parseInt(e.target.value, 10) / 100;
    qualityVal.textContent = e.target.value + '%';
  });
  qualitySlider?.addEventListener('change', () => {
    if (filesQueue.length > 0) reprocessAll();
  });

  formatSelect?.addEventListener('change', (e) => {
    currentFormat = e.target.value;
    if (filesQueue.length > 0) reprocessAll();
  });

  targetKbInput?.addEventListener('change', () => {
    if (filesQueue.length > 0) reprocessAll();
  });
  targetUnitSelect?.addEventListener('change', () => {
    if (filesQueue.length > 0) reprocessAll();
  });
  scalePercentInput?.addEventListener('change', (e) => {
    scalePercent = parseFloat(e.target.value) || 100;
    if (filesQueue.length > 0) reprocessAll();
  });
  dpiSelect?.addEventListener('change', (e) => {
    dpi = parseInt(e.target.value, 10) || 72;
    if (filesQueue.length > 0) reprocessAll();
  });
  fitModeSelect?.addEventListener('change', (e) => {
    fitMode = e.target.value;
    if (filesQueue.length > 0) reprocessAll();
  });
  stripExifCheckbox?.addEventListener('change', (e) => {
    stripExif = e.target.checked;
    if (filesQueue.length > 0) reprocessAll();
  });

  // Image Processing Core
  async function processImage(file) {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = async (e) => {
        const img = new Image();
        img.onload = async () => {
          const originalWidth = img.naturalWidth || img.width;
          const originalHeight = img.naturalHeight || img.height;

          // Determine Dimensions based on Scale & DPI
          let targetWidth = originalWidth;
          let targetHeight = originalHeight;

          if (currentMode === 'dimensions') {
            const scaleFactor = (parseFloat(scalePercentInput.value) || 100) / 100;
            targetWidth = Math.round(originalWidth * scaleFactor);
            targetHeight = Math.round(originalHeight * scaleFactor);
          }

          // Offscreen Canvas
          const canvas = document.createElement('canvas');
          canvas.width = targetWidth;
          canvas.height = targetHeight;
          const ctx = canvas.getContext('2d', { alpha: true, willReadFrequently: true });

          // Render
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.drawImage(img, 0, 0, targetWidth, targetHeight);

          // Output MIME Type
          let outMime = currentFormat === 'auto' ? (file.type || 'image/jpeg') : currentFormat;
          if (outMime === 'image/svg+xml') outMime = 'image/png'; // rasterize SVGs

          let currentQuality = parseInt(qualitySlider.value, 10) / 100;

          // If Target Size Mode: Binary Search
          if (currentMode === 'target') {
            const maxBytes = getTargetBytes();
            let low = 0.05;
            let high = 1.0;
            let bestBlob = null;
            let iterations = 0;

            // First try at default quality
            let testBlob = await new Promise(res => canvas.toBlob(res, outMime, 0.85));
            if (testBlob.size <= maxBytes) {
              bestBlob = testBlob;
            } else {
              while (low <= high && iterations < 7) {
                iterations++;
                const mid = (low + high) / 2;
                const blob = await new Promise(res => canvas.toBlob(res, outMime, mid));
                if (blob.size <= maxBytes) {
                  bestBlob = blob;
                  low = mid + 0.05;
                } else {
                  high = mid - 0.05;
                }
              }
              // If still over cap, downscale dimensions slightly
              if (!bestBlob || bestBlob.size > maxBytes) {
                let downscale = 0.85;
                while (downscale > 0.2) {
                  const downCanvas = document.createElement('canvas');
                  downCanvas.width = Math.round(targetWidth * downscale);
                  downCanvas.height = Math.round(targetHeight * downscale);
                  const downCtx = downCanvas.getContext('2d');
                  downCtx.drawImage(img, 0, 0, downCanvas.width, downCanvas.height);
                  const downBlob = await new Promise(res => downCanvas.toBlob(res, outMime, 0.65));
                  if (downBlob.size <= maxBytes) {
                    bestBlob = downBlob;
                    targetWidth = downCanvas.width;
                    targetHeight = downCanvas.height;
                    break;
                  }
                  downscale -= 0.15;
                }
              }
            }

            const resultBlob = bestBlob || (await new Promise(res => canvas.toBlob(res, outMime, 0.5)));
            const outputUrl = URL.createObjectURL(resultBlob);

            resolve({
              id: Math.random().toString(36).substring(2, 9),
              file: file,
              originalName: file.name,
              originalSize: file.size,
              originalWidth: originalWidth,
              originalHeight: originalHeight,
              originalUrl: e.target.result,
              reducedBlob: resultBlob,
              reducedSize: resultBlob.size,
              reducedWidth: targetWidth,
              reducedHeight: targetHeight,
              reducedUrl: outputUrl,
              outputMime: outMime,
              savingsPercent: Math.max(0, Math.round(((file.size - resultBlob.size) / file.size) * 100))
            });
            return;
          }

          // Standard Mode
          canvas.toBlob((blob) => {
            const outputUrl = URL.createObjectURL(blob);
            resolve({
              id: Math.random().toString(36).substring(2, 9),
              file: file,
              originalName: file.name,
              originalSize: file.size,
              originalWidth: originalWidth,
              originalHeight: originalHeight,
              originalUrl: e.target.result,
              reducedBlob: blob,
              reducedSize: blob.size,
              reducedWidth: targetWidth,
              reducedHeight: targetHeight,
              reducedUrl: outputUrl,
              outputMime: outMime,
              savingsPercent: Math.max(0, Math.round(((file.size - blob.size) / file.size) * 100))
            });
          }, outMime, currentQuality);
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    });
  }

  // Add Files to Queue
  async function handleFiles(files) {
    if (!files || files.length === 0) return;
    batchSection.classList.remove('hidden');

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (!file.type.startsWith('image/')) continue;
      const processed = await processImage(file);
      filesQueue.push(processed);
      renderFileCard(processed);
    }

    updateStats();
  }

  // "Try an example" button functionality
  trySampleBtn?.addEventListener('click', async () => {
    const sampleCanvas = document.createElement('canvas');
    sampleCanvas.width = 1920;
    sampleCanvas.height = 1080;
    const sctx = sampleCanvas.getContext('2d');

    sctx.fillStyle = '#0f172a';
    sctx.fillRect(0, 0, 1920, 1080);

    sctx.fillStyle = '#334155';
    sctx.fillRect(200, 300, 400, 780);
    sctx.fillStyle = '#1e293b';
    sctx.fillRect(700, 180, 500, 900);
    sctx.fillStyle = '#475569';
    sctx.fillRect(1300, 250, 450, 830);

    sctx.fillStyle = '#38bdf8';
    sctx.font = 'bold 72px sans-serif';
    sctx.fillText('SAMPLE HIGH-RESOLUTION IMAGE', 240, 220);

    sctx.fillStyle = '#94a3b8';
    sctx.font = '40px monospace';
    sctx.fillText('1920 × 1080 px • 100% Private In-Browser Processing', 240, 290);

    sampleCanvas.toBlob(async (blob) => {
      const sampleFile = new File([blob], 'sample-photography-demo.jpg', { type: 'image/jpeg' });
      await handleFiles([sampleFile]);
    }, 'image/jpeg', 0.95);
  });

  // Reprocess all files with updated settings
  async function reprocessAll() {
    if (filesQueue.length === 0) return;
    const oldFiles = filesQueue.map(item => item.file);
    filesQueue = [];
    fileList.innerHTML = '';
    for (const file of oldFiles) {
      const processed = await processImage(file);
      filesQueue.push(processed);
      renderFileCard(processed);
    }
    updateStats();
  }

  // Update Global Summary Stats
  function updateStats() {
    statCount.textContent = filesQueue.length + (filesQueue.length === 1 ? ' file' : ' files');
    const totalOriginal = filesQueue.reduce((acc, item) => acc + item.originalSize, 0);
    const totalReduced = filesQueue.reduce((acc, item) => acc + item.reducedSize, 0);

    statOriginalSize.textContent = formatBytes(totalOriginal);
    statReducedSize.textContent = formatBytes(totalReduced);

    if (totalOriginal > 0) {
      const saved = Math.max(0, Math.round(((totalOriginal - totalReduced) / totalOriginal) * 100));
      statSavedPercent.textContent = `-${saved}%`;
    } else {
      statSavedPercent.textContent = '0%';
    }
  }

  // Render individual file card
  function renderFileCard(item) {
    const extMap = {
      'image/webp': 'webp',
      'image/jpeg': 'jpg',
      'image/png': 'png',
      'image/avif': 'avif'
    };
    const extension = extMap[item.outputMime] || 'jpg';
    const baseName = item.originalName.replace(/\.[^/.]+$/, "");
    const downloadName = `${baseName}-reduced.${extension}`;

    const card = document.createElement('div');
    card.id = `file-card-${item.id}`;
    card.className = 'card-enter p-3.5 sm:p-4 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] flex flex-wrap items-center justify-between gap-4 transition-all duration-200 hover:border-[var(--color-hairline-strong)] hover:shadow-xs';

    card.innerHTML = `
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-12 h-12 rounded-lg bg-[var(--color-canvas-subtle)] border border-[var(--color-hairline)] overflow-hidden shrink-0 flex items-center justify-center">
          <img src="${item.reducedUrl}" alt="${item.originalName}" class="w-full h-full object-cover" />
        </div>
        <div class="min-w-0">
          <p class="text-xs sm:text-sm font-medium text-[var(--color-ink)] truncate max-w-[180px] sm:max-w-xs" title="${item.originalName}">
            ${item.originalName}
          </p>
          <div class="flex items-center gap-2 mt-0.5 text-[11px] font-mono text-[var(--color-mute)]">
            <span>${formatBytes(item.originalSize)}</span>
            <span>→</span>
            <span class="font-semibold text-[var(--color-ink)]">${formatBytes(item.reducedSize)}</span>
            <span class="px-1.5 py-0.5 rounded bg-[var(--color-canvas-subtle)] text-[var(--color-ink)] border border-[var(--color-hairline)] font-bold">-${item.savingsPercent}%</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button type="button" data-compare-id="${item.id}" class="compare-btn px-3 py-1.5 rounded-full border border-[var(--color-hairline)] text-xs text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-subtle)] transition-colors cursor-pointer">
          Compare
        </button>
        <a href="${item.reducedUrl}" download="${downloadName}" class="rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] px-3.5 py-1.5 text-xs font-medium transition-opacity hover:opacity-90 flex items-center gap-1">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Save</span>
        </a>
        <button type="button" data-remove-id="${item.id}" class="remove-btn p-1.5 text-[var(--color-mute)] hover:text-red-500 transition-colors cursor-pointer" title="Remove">
          ✕
        </button>
      </div>
    `;

    fileList.appendChild(card);

    // Compare Handler
    card.querySelector(`[data-compare-id="${item.id}"]`).addEventListener('click', () => {
      openCompareModal(item);
    });

    // Remove Handler
    card.querySelector(`[data-remove-id="${item.id}"]`).addEventListener('click', () => {
      filesQueue = filesQueue.filter(f => f.id !== item.id);
      card.remove();
      updateStats();
      if (filesQueue.length === 0) batchSection.classList.add('hidden');
    });
  }

  // Clear All
  clearAllBtn?.addEventListener('click', () => {
    filesQueue = [];
    fileList.innerHTML = '';
    batchSection.classList.add('hidden');
    updateStats();
  });

  reprocessAllBtn?.addEventListener('click', reprocessAll);

  // Bulk ZIP Download
  downloadZipBtn?.addEventListener('click', async () => {
    if (filesQueue.length === 0) return;
    if (typeof JSZip === 'undefined') {
      alert('JSZip library is initializing, please try again in a moment.');
      return;
    }

    const zip = new JSZip();
    const folder = zip.folder('reduced-images');

    for (let i = 0; i < filesQueue.length; i++) {
      const item = filesQueue[i];
      const extMap = {
        'image/webp': 'webp',
        'image/jpeg': 'jpg',
        'image/png': 'png',
        'image/avif': 'avif'
      };
      const ext = extMap[item.outputMime] || 'jpg';
      const name = `${item.originalName.replace(/\.[^/.]+$/, "")}-reduced.${ext}`;
      folder.file(name, item.reducedBlob);
    }

    const content = await zip.generateAsync({ type: 'blob' });
    const zipUrl = URL.createObjectURL(content);
    const downloadLink = document.createElement('a');
    downloadLink.href = zipUrl;
    downloadLink.download = `free-reduce-image-batch-${Date.now()}.zip`;
    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
  });

  // Modal Comparison Logic
  function openCompareModal(item) {
    compareOriginalImg.src = item.originalUrl;
    compareCompressedImg.src = item.reducedUrl;

    modalSavingsBadge.textContent = `Saved ${item.savingsPercent}%`;
    modalOriginalInfo.textContent = `Original: ${formatBytes(item.originalSize)} (${item.originalWidth}×${item.originalHeight})`;
    modalReducedInfo.textContent = `Reduced: ${formatBytes(item.reducedSize)} (${item.reducedWidth}×${item.reducedHeight})`;

    const extMap = { 'image/webp': 'webp', 'image/jpeg': 'jpg', 'image/png': 'png', 'image/avif': 'avif' };
    const ext = extMap[item.outputMime] || 'jpg';
    modalDownloadAction.href = item.reducedUrl;
    modalDownloadAction.download = `${item.originalName.replace(/\.[^/.]+$/, "")}-reduced.${ext}`;

    compareModal.classList.remove('hidden');
    updateSplitPosition(50);
  }

  function closeCompareModal() {
    compareModal.classList.add('hidden');
  }

  closeModalBtn?.addEventListener('click', closeCompareModal);
  modalCloseAction?.addEventListener('click', closeCompareModal);

  // Split Divider Dragging
  let isDraggingSplit = false;

  function updateSplitPosition(percent) {
    percent = Math.max(0, Math.min(100, percent));
    splitDivider.style.left = percent + '%';
    compareCompressedWrapper.style.clipPath = `inset(0 0 0 ${percent}%)`;
  }

  splitDivider?.addEventListener('mousedown', (e) => {
    e.preventDefault();
    isDraggingSplit = true;
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDraggingSplit) return;
    const rect = splitContainer.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const percent = (x / rect.width) * 100;
    updateSplitPosition(percent);
  });

  window.addEventListener('mouseup', () => {
    isDraggingSplit = false;
  });

  // Touch support for split slider
  splitDivider?.addEventListener('touchstart', () => { isDraggingSplit = true; }, { passive: true });
  window.addEventListener('touchmove', (e) => {
    if (!isDraggingSplit || !e.touches[0]) return;
    const rect = splitContainer.getBoundingClientRect();
    const x = e.touches[0].clientX - rect.left;
    const percent = (x / rect.width) * 100;
    updateSplitPosition(percent);
  }, { passive: true });
  window.addEventListener('touchend', () => { isDraggingSplit = false; });

  // Dropzone drag & drop handlers
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-[var(--color-ink)]');
  });

  dropzone?.addEventListener('dragleave', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[var(--color-ink)]');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[var(--color-ink)]');
    if (e.dataTransfer && e.dataTransfer.files) {
      handleFiles(e.dataTransfer.files);
    }
  });

  fileInput?.addEventListener('change', (e) => {
    if (e.target.files) {
      handleFiles(e.target.files);
    }
  });

  // Global paste support (Ctrl+V / Cmd+V)
  window.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    const imageFiles = [];
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.indexOf('image') !== -1) {
        const file = items[i].getAsFile();
        if (file) imageFiles.push(file);
      }
    }
    if (imageFiles.length > 0) {
      handleFiles(imageFiles);
    }
  });
})();
</script>

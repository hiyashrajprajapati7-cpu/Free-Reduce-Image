  }
  .mode-tab:hover {
    color: #171717;
  }
  .mode-tab.active-mode {
    background-color: #171717 !important;
    color: #ffffff !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08) !important;

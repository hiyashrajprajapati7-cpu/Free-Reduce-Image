---
const faqs = [
  {
    q: "How to reduce image file size without losing quality?",
    a: "Upload your image, choose Smart Auto mode or Target KB mode, and let the algorithm apply perceptual chroma subsampling and adaptive quantization. The tool strips invisible EXIF metadata and eliminates redundant color frequencies that the human eye cannot distinguish, reducing file size by up to 85% while keeping sharpness and colors intact."
  },
  {
    q: "How can I reduce image size in KB (e.g., under 50 KB or 100 KB)?",
    a: "Switch to the 'Target (KB)' tab in the reducer tool, enter your desired file cap (such as 20, 50, 100, or 200 KB), and click Compress. Our binary search engine automatically calculates the exact mathematical compression ratio needed to ensure your file strictly meets government portal or visa requirements on the first try."
  },
  {
    q: "Can I use this tool as a JPG size reducer to compress JPG photos?",
    a: "Yes. Free Reduce Image is an advanced JPG size reducer. It decodes JPEG files locally and re-encodes them with optimized Discrete Cosine Transform (DCT) quantization tables. You can easily compress 10 MB+ smartphone photos down to under 200 KB in seconds."
  },
  {
    q: "What is the difference between reduce image resolution and reduce image quality?",
    a: "To reduce image resolution means changing the pixel dimensions (e.g. from 4000×3000 down to 1200×900 pixels), which physically downsizes the image. To reduce image quality means keeping pixel dimensions unchanged while compressing color data. For the best result, downscale excessive mega-dimensions first, then apply smart compression."
  },
  {
    q: "Is Free Reduce Image safe for passport photos, visas, and private documents?",
    a: "Absolutely. 100% of the image processing happens client-side inside your own web browser using HTML5 Canvas. Your sensitive passport scans, ID cards, and family photos are never uploaded to any remote server or stored in any database."
  },
  {
    q: "Can I reduce image file size for multiple files in batch?",
    a: "Yes. You can upload 100+ photos at once, paste images directly from your clipboard, or drag and drop entire folders. All files are compressed simultaneously with multithreaded native browser speed, and you can download all results in a single structured ZIP archive."
  },
  {
    q: "Which image format gives the smallest file size?",
    a: "Next-generation formats like WebP and AVIF typically provide 30% to 50% smaller file sizes than traditional JPEG at equivalent visual quality. You can convert JPG or PNG to WebP and AVIF directly using our Convert tab."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<section id="faq" class="py-16 sm:py-20 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <p class="eyebrow">Questions & Answers</p>
    <h2 class="mt-3 text-display-lg text-[var(--color-ink)]">
      Frequently asked questions
    </h2>

    <!-- Accordion matching fontfinderai.com -->
    <div class="mt-8 divide-y divide-[var(--color-hairline)] border-y border-[var(--color-hairline)]">
      {faqs.map((faq) => (
        <details class="group py-4 sm:py-5 cursor-pointer">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-base sm:text-lg font-medium text-[var(--color-ink)] select-none list-none [&::-webkit-details-marker]:hidden">
            <span>{faq.q}</span>
            <svg class="size-5 shrink-0 text-[var(--color-mute)] transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
            </svg>
          </summary>
          <p class="mt-3 max-w-2xl text-body-md text-[var(--color-body)] leading-relaxed">
            {faq.a}
          </p>
        </details>
      ))}
    </div>

  </div>

  <!-- Schema.org FAQ JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

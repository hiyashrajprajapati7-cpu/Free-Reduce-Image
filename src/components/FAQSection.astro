---
const faqs = [
  {
    q: "Is it really a free image reducer?",
    a: "Yes — unlimited compressions, no account required, and no credit card. The reduction runs locally in your own browser using HTML5 Canvas, so it costs us almost nothing to let you use it as much as you like."
  },
  {
    q: "Can I use the image reducer by uploading or dragging multiple files?",
    a: "Yes. Upload a single file, select 100+ files at once, drag them onto the page, or paste straight from your clipboard with ⌘V / Ctrl+V. You can download each file individually or export everything in a single 1-click ZIP archive."
  },
  {
    q: "How does it reduce image size without losing quality?",
    a: "Your browser optimizes color indexing, removes redundant metadata, and applies perceptual chroma quantization where the human eye cannot detect loss. This reduces file weight by up to 85% while preserving edge sharpness and colors."
  },
  {
    q: "Do you store or upload my images?",
    a: "No, and we could not even if we wanted to — your images are never uploaded to a server. The whole compression engine runs locally in your browser, and the site itself is static files."
  },
  {
    q: "How does the Target File Size mode work (e.g. under 100 KB)?",
    a: "Our algorithm executes a binary search across compression quantization and dimension levels to guarantee your image strictly stays below your specified limit (such as 50 KB, 100 KB, or 200 KB) for visa forms, passport portals, and job applications."
  },
  {
    q: "What image formats are supported?",
    a: "PNG, JPG, JPEG, WebP, AVIF, GIF, BMP, and SVG files are fully supported. You can convert between WebP, AVIF, JPEG, and PNG directly in your browser."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<section id="faq" class="py-16 sm:py-20 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <p class="eyebrow">Questions & Answers</p>
    <h2 class="mt-3 text-display-lg text-[var(--color-ink)]">
      Frequently asked questions
    </h2>

    <!-- Accordion matching fontfinderai.com -->
    <div class="mt-8 divide-y divide-[var(--color-hairline)] border-y border-[var(--color-hairline)]">
      {faqs.map((faq) => (
        <details class="group py-4 sm:py-5 cursor-pointer">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-base sm:text-lg font-medium text-[var(--color-ink)] select-none list-none [&::-webkit-details-marker]:hidden">
            <span>{faq.q}</span>
            <svg class="size-5 shrink-0 text-[var(--color-mute)] transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
            </svg>
          </summary>
          <p class="mt-3 max-w-2xl text-body-md text-[var(--color-body)] leading-relaxed">
            {faq.a}
          </p>
        </details>
      ))}
    </div>

  </div>

  <!-- Schema.org FAQ JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
